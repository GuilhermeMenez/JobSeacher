{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vagas-bot.local/contrato/resposta-ingestao.schema.json",
  "title": "Resposta da ingestão",
  "description": "Resposta do POST /api/ingestao/vagas (HTTP 200). Vagas recusadas não derrubam o lote: aparecem em 'erros'.",
  "type": "object",
  "additionalProperties": false,
  "required": ["recebidas", "novas", "atualizadas", "duplicadas", "rejeitadas", "erros"],
  "properties": {
    "recebidas": { "type": "integer", "minimum": 0 },
    "novas": {
      "description": "Vagas que não existiam (por fonte+idExterno).",
      "type": "integer",
      "minimum": 0
    },
    "atualizadas": {
      "description": "Já existiam e vieram com dados novos (ex.: descrição que faltava).",
      "type": "integer",
      "minimum": 0
    },
    "duplicadas": {
      "description": "Já existiam sem mudanças, ou são a mesma vaga vinda de outra fonte.",
      "type": "integer",
      "minimum": 0
    },
    "rejeitadas": {
      "description": "Falharam na validação. Detalhes em 'erros'.",
      "type": "integer",
      "minimum": 0
    },
    "erros": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["indice", "motivo"],
        "properties": {
          "indice": {
            "description": "Posição da vaga no array 'vagas' do lote (começa em 0).",
            "type": "integer",
            "minimum": 0
          },
          "idExterno": { "type": ["string", "null"] },
          "motivo": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
