# Copie este arquivo para .env (Copy-Item .env.example .env) e ajuste os valores.
# O .env NÃO vai para o Git.

# --- PostgreSQL (etapa 1) ---
POSTGRES_DB=vagas
POSTGRES_USER=vagas
POSTGRES_PASSWORD=troque-esta-senha
# Mude se já tiver outro Postgres usando a 5432 no Windows (ex.: 5433)
POSTGRES_PORT=5432

# --- Chaves das fontes (etapas 3 a 5) ---
# GITHUB_TOKEN=
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=
# CAREERJET_API_KEY=

# --- Notificação (etapa 6) ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
