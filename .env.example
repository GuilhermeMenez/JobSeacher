# Copie este arquivo para .env (Copy-Item .env.example .env) e ajuste os valores.
# O .env NÃO vai para o Git.

# --- MongoDB ---
MONGO_USER=vagas
MONGO_PASSWORD=troque-esta-senha
# Mude se já tiver outro MongoDB usando a 27017 no Windows (ex.: 27018)
MONGO_PORT=27017
# Conexão usada pelo núcleo Java rodando FORA do Docker (ex.: pela IDE):
# MONGODB_URI=mongodb://vagas:troque-esta-senha@localhost:27017/vagas?authSource=admin

# --- RabbitMQ (fila entre o scraper Python e o núcleo Java) ---
RABBITMQ_USER=vagas
RABBITMQ_PASSWORD=troque-esta-senha-tambem
RABBITMQ_PORT=5672
# Painel web: http://localhost:15672
RABBITMQ_PAINEL_PORT=15672

# --- Chaves das fontes (etapas 3 a 5) ---
# GITHUB_TOKEN=
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=
# CAREERJET_API_KEY=

# --- Notificação (etapa 6) ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
